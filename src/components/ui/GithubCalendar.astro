---
interface Props {
  username?: string;
}

const { username = "theajmalrazaq" } = Astro.props;
---

<div class="github-calendar-widget w-full max-w-4xl mx-auto" data-username={username} data-aos="focus-up">
  <div class="flex flex-col gap-4 p-6 bg-gray-50/50 dark:bg-neutral-900/50 backdrop-blur-md border border-gray-200 dark:border-neutral-800 rounded-3xl shadow-xl">
    <div class="flex justify-between items-center select-none mb-2">
      <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 font-product-sans flex items-center gap-2">
        <i class="hgi-stroke hgi-github-01 text-base"></i>
        github contributions
      </h3>
      <a href={`https://github.com/${username}`} target="_blank" class="text-xs text-gray-500 hover:text-accent font-product-sans flex items-center gap-1 transition-colors duration-300">
        @{username}
        <i class="hgi-stroke hgi-arrow-up-right text-[10px]"></i>
      </a>
    </div>

    <!-- Months and Grid Wrapper -->
    <div class="w-full max-w-full min-w-0 overflow-x-auto no-scrollbar py-2 -my-2">
      <div class="min-w-[750px] flex flex-col gap-2">
        <!-- Month labels -->
        <div id="github-months" class="grid w-full select-none" style="grid-template-columns: repeat(53, minmax(0, 1fr)); height: 16px;">
          {Array.from({ length: 53 }).map(() => (
            <div class="h-4"></div>
          ))}
        </div>
        
        <!-- Grid -->
        <div id="github-grid" class="grid gap-1 w-full select-none" style="grid-template-columns: repeat(53, minmax(0, 1fr)); grid-template-rows: repeat(7, minmax(0, 1fr));">
          {Array.from({ length: 371 }).map(() => (
            <div class="w-full aspect-square rounded-[2px] bg-gray-100 dark:bg-neutral-900 border border-gray-200/20 dark:border-neutral-800/20 transition-all duration-500"></div>
          ))}
        </div>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-500 dark:text-gray-400 font-product-sans mt-2">
      <div id="github-total-contributions">
        loading contributions...
      </div>
      <div class="flex items-center gap-2 select-none">
        <span>Less</span>
        <div class="w-3 h-3 rounded-[2px] bg-gray-100/50 dark:bg-neutral-900/50 border border-gray-200/10 dark:border-neutral-800/10"></div>
        <div class="w-3 h-3 rounded-[2px] bg-gray-300/70 dark:bg-neutral-800/80"></div>
        <div class="w-3 h-3 rounded-[2px] bg-gray-400 dark:bg-neutral-700"></div>
        <div class="w-3 h-3 rounded-[2px] bg-gray-600 dark:bg-neutral-500"></div>
        <div class="w-3 h-3 rounded-[2px] bg-gray-950 dark:bg-neutral-100"></div>
        <span>More</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Custom month label styling */
  :global(.github-month-label) {
    font-size: 10px;
    color: #9ca3af; /* text-gray-400 */
    white-space: nowrap;
    position: relative;
    width: 0;
    overflow: visible;
  }
  :global(.dark .github-month-label) {
    color: #6b7280; /* text-gray-500 */
  }
</style>

<script>
  async function fetchContributions() {
    const widgets = document.querySelectorAll(".github-calendar-widget");
    
    widgets.forEach(async (widget) => {
      const username = widget.getAttribute("data-username");
      if (!username) return;
      
      const grid = widget.querySelector("#github-grid");
      const monthsContainer = widget.querySelector("#github-months");
      const totalContainer = widget.querySelector("#github-total-contributions");
      
      if (!grid || !totalContainer) return;
      
      try {
        const response = await fetch(`https://github-contributions-api.deno.dev/${username}.json?flat=true`);
        if (!response.ok) throw new Error("Failed to fetch contributions");
        
        const data = await response.json();
        const contributions = data.contributions;
        
        if (!contributions || contributions.length === 0) return;
        
        // Clear grid and month labels
        grid.innerHTML = "";
        
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const monthLabels = Array(53).fill("");
        let lastMonth = -1;
        
        // Render squares
        contributions.forEach((day: any, index: number) => {
          // Keep it to max 371 days (53 weeks)
          if (index >= 371) return;
          
          const date = new Date(day.date);
          const month = date.getMonth();
          const weekIndex = Math.floor(index / 7);
          
          // Align month label to the week it starts in
          if (index % 7 === 0 && month !== lastMonth && weekIndex < 53) {
            monthLabels[weekIndex] = monthNames[month];
            lastMonth = month;
          }
          
          const square = document.createElement("div");
          square.className = `w-full aspect-square rounded-[2px] transition-all duration-500 ${getLevelClass(day.contributionLevel, day.contributionCount)}`;
          
          const formattedDate = date.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          });
          square.title = `${day.contributionCount} contribution${day.contributionCount === 1 ? '' : 's'} on ${formattedDate}`;
          
          grid.appendChild(square);
        });
        
        // Render month labels
        if (monthsContainer) {
          monthsContainer.innerHTML = "";
          monthLabels.forEach((label) => {
            const labelContainer = document.createElement("div");
            labelContainer.className = "relative h-4";
            
            if (label) {
              const span = document.createElement("span");
              span.textContent = label;
              span.className = "github-month-label absolute left-0 top-0 font-product-sans";
              labelContainer.appendChild(span);
            }
            monthsContainer.appendChild(labelContainer);
          });
        }
        
        // Set total count
        const total = contributions.reduce((sum: number, day: any) => sum + day.contributionCount, 0);
        totalContainer.textContent = `${total.toLocaleString()} contributions in the past 365 days.`;
        
      } catch (error) {
        console.error(error);
        totalContainer.textContent = "Failed to load contributions.";
      }
    });
  }
  
  function getLevelClass(level: string, count: number) {
    if (level === 'FOURTH_QUARTILE' || count >= 10) {
      return 'bg-gray-950 dark:bg-neutral-100';
    }
    if (level === 'THIRD_QUARTILE' || count >= 6) {
      return 'bg-gray-600 dark:bg-neutral-400';
    }
    if (level === 'SECOND_QUARTILE' || count >= 3) {
      return 'bg-gray-400 dark:bg-neutral-600';
    }
    if (level === 'FIRST_QUARTILE' || count >= 1) {
      return 'bg-gray-300/70 dark:bg-neutral-800/80';
    }
    return 'bg-gray-100/50 dark:bg-neutral-900/50 border border-gray-200/10 dark:border-neutral-800/10';
  }

  // Load on start
  fetchContributions();
  // Support Astro View Transitions
  document.addEventListener("astro:page-load", fetchContributions);
</script>
